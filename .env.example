# App
APP_NAME=HydroGuard
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=smart_water

# MQTT
MQTT_ENABLED=true
MQTT_TLS=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=fastapi-backend
MQTT_TOPIC_SENSOR=home/+/+/sensor
MQTT_TOPIC_ALERT=home/+/+/alert
MQTT_TOPIC_STATUS=home/+/+/status

# API access
ADMIN_API_KEY=

# Public dashboard demo
DEMO_PUBLIC_ACTIONS_ENABLED=true
DEMO_DEVICE_ID=device01

# Frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert timing
ALERT_DURATION_THRESHOLD_SEC=300
# Demo routes and the admin-only simulate route can use this multiplier.
# MQTT/device messages always use real 1x elapsed time.
DEMO_TIME_SCALE=10

# MQTT validation
TIMESTAMP_SKEW_PAST_SEC=3600
TIMESTAMP_SKEW_FUTURE_SEC=300
MQTT_MAX_PAYLOAD_BYTES=512

# Device connection monitoring
DEVICE_OFFLINE_AFTER_SEC=60
DEVICE_STATUS_CHECK_INTERVAL_SEC=10

# HydroGuard alert and valve configuration
ALERT_COOLDOWN_SEC=300
CRITICAL_FLOW_RATE_LPM=0.3
AUTOMATIC_SHUTOFF_ENABLED=false
